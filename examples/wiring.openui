root = Screens([arrival, ready, phase, pause, closing])
arrival = Screen([arrival_title, arrival_copy, arrival_note, arrival_options, arrival_memory_status, arrival_memory_options, arrival_cue])
arrival_title = Text("What do you need right now?", "title")
arrival_copy = Text("Say it in your own words. Aira will turn that into a session you can still change.", "description")
arrival_note = Alert("info", "Local AI interaction demo · your words change the session screen")
arrival_options = FollowUps(["Clear my head", "Wake me up", "I only have 8 minutes"])
arrival_cue = Cue("There’s no perfect way to ask. Tell me what would help right now.")
ready = Screen([ready_title, plan_summary, plan_goal, plan_time, plan_intervals, plan_cue_mode, ready_options, ready_cue])
ready_title = Text("Here’s a shape that could fit", "title")
plan_summary = Text("I heard a short reset. This is a starting point, not a fixed routine.", "description")
plan_goal = Keyword("Start gently", "What Aira heard in your request")
plan_time = Keyword("8 minutes", "Your planned window · demo timers are shorter")
plan_intervals = Keyword("30s phase · 30s pause", "Short on-screen samples · adjustable any time")
plan_cue_mode = Keyword("Short cues", "Cue style for this session")
ready_options = FollowUps(["Make it gentler", "Keep cues quiet", "Start this session"])
ready_cue = Cue("Does this feel right? You can adjust the plan before we start.")
phase = Screen([phase_title, phase_copy, timer1, phase_shape, phase_cue_mode, phase_change_log, phase_options, phase_cue])
phase_title = Text("First phase", "title")
phase_copy = Text("Start the on-screen timer when you’re ready. You can type a change while it runs; I’ll update the screen with you.", "description")
timer1 = Timer("30s phase · demo", 30)
phase_shape = Keyword("30s phase · 30s pause", "Your session shape · short local samples")
phase_cue_mode = Keyword("Short cues", "Cue style for this session")
phase_change_log = List([phase_change1, phase_change2])
phase_change1 = ListItem("No adjustments yet", "plus")
phase_change2 = ListItem("You decide what happens next", "plus")
phase_options = FollowUps(["Make it easier", "Keep cues quiet", "Skip this phase", "Finish now"])
phase_cue = Cue("Steady.")
pause = Screen([pause_title, pause_copy, timer2, pause_shape, pause_options, pause_cue])
pause_title = Text("A pause, on your terms", "title")
pause_copy = Text("This is a separate on-screen pause sample. Extend it, skip it, or stop here.", "description")
timer2 = Timer("30s pause · demo", 30)
pause_shape = Keyword("30s phase · 30s pause", "Your current session shape")
pause_options = FollowUps(["More time", "Skip the pause", "Finish now"])
pause_cue = Cue("Take the time you need.")
closing = Screen([closing_title, closing_copy, closing_plan, closing_adaptation, closing_change_log, closing_memory_status, closing_memory_options, closing_cue])
closing_title = Text("You shaped this session", "title")
closing_copy = Text("Aira changed the session when you asked. The timers were short demonstrations; no physical activity was requested or tracked.", "description")
closing_plan = Keyword("Start gently · 8 min · 30/30", "The session shape you chose")
closing_adaptation = Keyword("No adjustment yet", "Latest session adjustment")
arrival_memory_status = Keyword("Nothing saved", "Aira remembers only if you choose · saved for this tab only")
arrival_memory_options = FollowUps(["Use my saved setup", "Forget my saved setup"])
closing_change_log = List([closing_change1, closing_change2])
closing_change1 = ListItem("No adjustments yet", "plus")
closing_change2 = ListItem("You decide what happens next", "plus")
closing_memory_status = Keyword("Nothing saved", "Aira remembers only if you choose · saved for this tab only")
closing_memory_options = FollowUps(["Remember this setup", "Not now"])
closing_cue = Cue("Thanks for shaping it with me. Your choices stayed in your hands.")
